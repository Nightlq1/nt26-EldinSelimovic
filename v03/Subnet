import ipaddress

# replace with whatever you want to calculate.
text = "192.168.1.0/24"

# The ipaddress module does the calculation for you.
net = ipaddress.ip_network(text, strict=False)

# All addresses you can assign to a device.
usable = list(net.hosts())

print(f"network:           {net.network_address}")
print(f"netmask:           {net.netmask}")
print(f"broadcast:         {net.broadcast_address}")
print(f"first address:     {usable[0]}")
print(f"last address:      {usable[-1]}")
print(f"number of devices: {len(usable)}")











mac = input("00:1A:2B:3C:4D:5C")

parts = mac.split(":")

if len(parts) == 6 and all(len(part) == 2 for part in parts):
    print ("Valid MAC address")
else:
    print ("Invalid MAC address")
